DROP TABLE TBL_VENUES;
DROP TABLE TBL_RESERVATIONS;
DROP TABLE TBL_CONCERTS;

CREATE TABLE TBL_VENUES(
VENUE_ID CHAR(4) PRIMARY KEY,
VENUE_NAME VARCHAR2(20),
ADRESS VARCHAR2(30),
CITY VARCHAR2(10),
CAPACITY NUMBER(10)
);

CREATE TABLE TBL_RESERVATIONS(
RESERVATION_ID CHAR(4),
CONCERT_ID CHAR(4),
BUYER_NAME VARCHAR2(10),
BUYER_PHONE VARCHAR2(13),
TICKET_COUNT NUMBER(10),
UNIT_PRICE NUMBER(10),
TOTAL_PRICE NUMBER(10),
PAY_STATUS NUMBER(1),
CONSTRAINT PK_RC PRIMARY KEY (RESERVATION_ID,CONCERT_ID)
);

select RESERVATION_ID,BUYER_NAME,BUYER_NAME,BUYER_PHONE,TICKET_COUNT, UNIT_PRICE,TOTAL_PRICE,PAY_STATUS from TBL_RESERVATIONS

CREATE TABLE TBL_CONCERTS(
CONCERT_ID CHAR(4),
VENUE_ID CHAR(4),
CONCERT_TITLE VARCHAR2(15),
ARTIST_NAME VARCHAR2(10),
CONCERT_DATE DATE,
START_TIME DATE,
END_TIME DATE,
BASE_PRICE NUMBER(10),
STATUS NUMBER(1),
CONSTRAINT PK_CV PRIMARY KEY (CONCERT_ID,VENUE_ID),
CONSTRAINT FK_R_V FOREIGN KEY (VENUE_ID) REFERENCES TBL_VENUES(VENUE_ID)
/*,
CONSTRAINT FK_C_R FOREIGN KEY (CONCERT_ID) REFERENCES TBL_RESERVATIONS(CONCERT_ID) */
);


